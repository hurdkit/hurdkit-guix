Build the DRI frontend, which EGL needs, on GNU/Hurd.

Mesa enables it only for systems with kernel mode setting; the Hurd
renders in software and through virgl's vtest transport.
diff --git a/meson.build b/meson.build
index 37f2fd4..a6f4186 100644
--- a/meson.build
+++ b/meson.build
@@ -361,7 +361,7 @@ with_vdrm = [
 ].contains(true)
 
 with_dri = false
-if with_gallium and (system_has_kms_drm or (with_gallium_zink and (freedreno_kmds.contains('kgsl') or host_machine.system() == 'darwin')))
+if with_gallium and (system_has_kms_drm or host_machine.system() == 'gnu' or (with_gallium_zink and (freedreno_kmds.contains('kgsl') or host_machine.system() == 'darwin')))
   _glx = get_option('glx')
   _egl = get_option('egl')
   if _glx == 'dri' or _egl.enabled() or (_glx == 'disabled' and _egl.allowed())
