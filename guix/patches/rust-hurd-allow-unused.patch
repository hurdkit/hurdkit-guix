From: Hurdkit <hurdkit@localhost>
Subject: [PATCH] std: allow used time constructor on Hurd

Hurd uses SystemTime::new, so expect(unused) is unfulfilled with deny(warnings).

--- a/library/std/src/sys/time/unix.rs
+++ b/library/std/src/sys/time/unix.rs
@@ -15,7 +15,7 @@

     pub const MIN: SystemTime = SystemTime { t: Timespec::MIN };

-    #[cfg_attr(any(target_os = "horizon", target_os = "hurd", target_os = "teeos"), expect(unused))]
+    #[cfg_attr(any(target_os = "horizon", target_os = "hurd", target_os = "teeos"), allow(unused))]
     pub fn new(tv_sec: i64, tv_nsec: i64) -> Result<SystemTime, io::Error> {
         Ok(SystemTime { t: Timespec::new(tv_sec, tv_nsec)? })
     }
