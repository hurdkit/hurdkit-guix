 void
 diskfs_shutdown_pager (void)
 {
+  if (pager_requests != NULL)
+    pager_inhibit_workers (pager_requests);
+}
+
+/* The kernel owns anonymous pages. Discard them on writeback, and release
+   this bookkeeping when the pager's last send right disappears. */
+void
+pager_clear_user_data (struct user_pager_info *upi)
+{
+  pthread_mutex_destroy (&upi->lock);
+  free (upi);
+}
+
+error_t
+pager_read_page (struct user_pager_info *upi, vm_offset_t page,
+                 vm_address_t *buf, int *write_lock)
+{
+  pthread_mutex_lock (&upi->lock);
+  if (page >= upi->size)
+    {
+      pthread_mutex_unlock (&upi->lock);
+      return EIO;
+    }
+  pthread_mutex_unlock (&upi->lock);
+  *write_lock = 0;
+  fprintf (stderr, "tmpfs page-in: offset=%lu size=%lu\n",
+           (unsigned long) page, (unsigned long) upi->size);
+  return vm_allocate (mach_task_self (), buf, vm_page_size, 1);
+}
+
+error_t
+pager_write_page (struct user_pager_info *upi, vm_offset_t page,
+                  vm_address_t buf)
+{
+  (void) upi;
+  (void) page;
+  return vm_deallocate (mach_task_self (), buf, vm_page_size);
+}
+
+error_t
+pager_unlock_page (struct user_pager_info *pager, vm_offset_t address)
+{
+  pthread_mutex_lock (&pager->lock);
+  if (address >= pager->size)
+    {
+      pthread_mutex_unlock (&pager->lock);
+      return EIO;
+    }
+  pthread_mutex_unlock (&pager->lock);
+  return 0;
+}
+
+void
+pager_notify_evict (struct user_pager_info *pager, vm_offset_t page)
+{
+  (void) pager;
+  (void) page;
+}
+
+error_t
+pager_report_extent (struct user_pager_info *upi,
+                     vm_address_t *offset, vm_size_t *size)
+{
+  *offset = 0;
+  pthread_mutex_lock (&upi->lock);
+  *size = upi->size;
+  pthread_mutex_unlock (&upi->lock);
+  return 0;
+}
+
+void
+pager_dropweak (struct user_pager_info *upi)
+{
+  (void) upi;
 }
 
