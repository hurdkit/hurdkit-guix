@@ -111,6 +111,22 @@ pager_flush_some (struct pager *pager,
 		  vm_size_t len,
 		  int wait);
 
+/* Restrict access to a range and flush its cached pages.  This is needed
+   when truncating a live mapping: a later access must ask the pager again
+   rather than use the old contents. */
+void
+pager_invalidate_some (struct pager *pager,
+		       vm_address_t start,
+		       vm_size_t len,
+		       int wait);
+
+/* Clear errors and invalid markers after a truncated file is grown again.
+   This does not restore old data; subsequent page-in supplies zeroes. */
+void
+pager_clear_errors (struct pager *pager,
+		    vm_address_t start,
+		    vm_size_t len);
+
 /* Flush data from the kernel for pager PAGER and force any pending
    delayed copies.  Wait for all pages to be flushed iff WAIT is set.
    Have the kernel write back modifications.  */
