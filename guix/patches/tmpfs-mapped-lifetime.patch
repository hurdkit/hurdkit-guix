+/* Zero the part of the last page that truncation discards. Do this before
+   shrinking the pager's valid extent: mapping a whole page after EOF would
+   fault on its inaccessible suffix. A separate send right avoids consuming
+   the pager's receive right or retaining a mapping after this returns. */
+static error_t
+zero_partial_tail (struct node *np, off_t eof)
+{
+  memory_object_t object;
+  vm_address_t address = 0;
+  vm_size_t length = round_page (eof) - eof;
+  error_t err;
+
+  if (length == 0 || eof == 0)
+    return 0;
+
+  object = ports_get_send_right (np->dn->u.reg.pager);
+  if (!MACH_PORT_VALID (object))
+    return EIO;
+  err = vm_map (mach_task_self (), &address, vm_page_size, 0, 1,
+                object, trunc_page (eof), 0,
+                VM_PROT_READ | VM_PROT_WRITE, VM_PROT_READ | VM_PROT_WRITE,
+                VM_INHERIT_NONE);
+  mach_port_deallocate (mach_task_self (), object);
+  if (err)
+    return err;
+
+  err = hurd_safe_memset ((void *) (address + eof - trunc_page (eof)),
+                          0, length);
+  if (!err)
+    err = vm_deallocate (mach_task_self (), address, vm_page_size);
+  else
+    vm_deallocate (mach_task_self (), address, vm_page_size);
+  return err;
+}
