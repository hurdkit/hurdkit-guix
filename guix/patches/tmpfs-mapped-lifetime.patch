diff --git a/libpager/pager-flush.c b/libpager/pager-flush.c
index bd7697ca..5c6d549c 100644
--- a/libpager/pager-flush.c
+++ b/libpager/pager-flush.c
@@ -42,3 +42,32 @@ pager_flush_some (struct pager *p, vm_address_t offset,
   _pager_lock_object (p, offset, size, MEMORY_OBJECT_RETURN_NONE, 1,
 		      VM_PROT_NO_CHANGE, wait);
 }
+
+
+/* Restrict access to a range before flushing it.  Unlike pager_flush_some,
+   this forces later accesses through the pager's extent and error checks. */
+void
+pager_invalidate_some (struct pager *p, vm_address_t offset,
+		       vm_size_t size, int wait)
+{
+  _pager_lock_object (p, offset, size, MEMORY_OBJECT_RETURN_NONE, 1,
+		      VM_PROT_ALL, wait);
+}
+
+/* An EOF fault is not permanent after the file grows. */
+void
+pager_clear_errors (struct pager *p, vm_address_t offset, vm_size_t length)
+{
+  vm_size_t first = offset / __vm_page_size;
+  vm_size_t last = (offset + length + __vm_page_size - 1) / __vm_page_size;
+  pthread_mutex_lock (&p->interlock);
+  if (last > p->pagemapsize)
+    last = p->pagemapsize;
+  if (p->pagemap)
+    {
+      vm_size_t index;
+      for (index = first; index < last; ++index)
+        p->pagemap[index] &= ~(PM_INVALID | 0xc | 0x3);
+    }
+  pthread_mutex_unlock (&p->interlock);
+}
diff --git a/libpager/pager.h b/libpager/pager.h
