diff --git a/libpager/pager-flush.c b/libpager/pager-flush.c
index bd7697ca..a90a9831 100644
--- a/libpager/pager-flush.c
+++ b/libpager/pager-flush.c
@@ -42,3 +42,28 @@ pager_flush_some (struct pager *p, vm_address_t offset,
   _pager_lock_object (p, offset, size, MEMORY_OBJECT_RETURN_NONE, 1,
 		      VM_PROT_NO_CHANGE, wait);
 }
+
+/* Invalidate pages in a truncated range and remove their old contents.
+   Restoring the former protection asks the pager on the next access. */
+void
+pager_invalidate_some (struct pager *p, vm_address_t offset,
+                       vm_size_t size, int wait)
+{
+  _pager_lock_object (p, offset, size, MEMORY_OBJECT_RETURN_NONE, 1,
+                      VM_PROT_NONE, wait);
+  _pager_lock_object (p, offset, size, MEMORY_OBJECT_RETURN_NONE, 1,
+                      VM_PROT_ALL, wait);
+}
+
+void
+pager_clear_errors (struct pager *p, vm_address_t offset, vm_size_t size)
+{
+  pthread_mutex_lock (&p->interlock);
+  for (vm_address_t page = offset; page < offset + size;
+       page += vm_page_size)
+    if (page / vm_page_size < p->pagemapsize)
+      p->pagemap[page / vm_page_size] =
+        SET_PM_ERROR (SET_PM_NEXTERROR (p->pagemap[page / vm_page_size], 0), 0)
+        & ~(PM_INVALID | PM_PAGEINWAIT | PM_PAGINGOUT);
+  pthread_mutex_unlock (&p->interlock);
+}
